# Copy this file to .env on the VPS before starting Docker Compose.
MYSQL_DATABASE=pharmaflow
MYSQL_USER=pharmaflow_app
MYSQL_PASSWORD=replace_with_a_long_random_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_long_random_root_password
JWT_SECRET=replace_with_at_least_32_random_characters
APP_PORT=3000
PUBLIC_HTTP_PORT=80
APP_URL=https://crm.example.com
OSM_TILE_BACKEND=http://tiles:8080/
OSRM_BASE_URL=http://osrm:5000
ROUTING_TIMEOUT_MS=5000
OSRM_DATA_DIR=./osrm-data
OSRM_DATASET=region-latest.osrm
# Optional customer-approved hosted model credentials. Leave unused providers blank.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional private GPU inference route. Start with: docker compose --profile local-ai up -d.
AI_LOCAL_MODEL_BASE_URL=http://local-ai:8000
AI_LOCAL_MODEL_API_KEY=replace_with_a_private_inference_key
AI_LOCAL_MODEL_MODEL=Qwen/Qwen2.5-7B-Instruct
AI_LOCAL_MODEL_MAX_LEN=8192
# Only required when the selected model must be downloaded from Hugging Face.
HF_TOKEN=
